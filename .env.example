# Publishable client ID issued by enter.pollinations.ai after registering the app
VITE_POLLINATIONS_CLIENT_ID=pk_replace_me

# Base for redirecting to the BYOP authorize endpoint (override for local mock server in CI)
VITE_POLLINATIONS_AUTHORIZE_BASE=https://enter.pollinations.ai

# Surface bases — Pollinations splits image vs text+audio across subdomains.
# Override in tests/e2e to point at the mock server (use the same URL for both).
VITE_POLLINATIONS_IMAGE_BASE=https://image.pollinations.ai
VITE_POLLINATIONS_TEXT_BASE=https://text.pollinations.ai
